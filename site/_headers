/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://tally.so https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://tally.so https://www.linkedin.com; connect-src 'self' https://cloudflareinsights.com https://tally.so; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://tally.so; object-src 'none'; upgrade-insecure-requests

/status.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-store

/graph.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-store
