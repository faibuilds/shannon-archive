/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-nqmhlOEHaKaiSeDVJTrutlAQss2Wc1NAZg6rjJmb9Nk=' 'sha256-eT5huNkbXqR13a+6Z8+oHRtBVn6PRylVBuyB2cGt9Ns=' https://tally.so https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://tally.so https://www.linkedin.com; connect-src 'self' https://cloudflareinsights.com https://tally.so; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://tally.so; object-src 'none'; upgrade-insecure-requests

/status.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-store

/graph.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-store

# Static assets: cache in the browser so repeat visits skip re-downloading.
# Art is a modest 1 day because plate PNGs are regenerated in place; the
# brand images change rarely, so a week. HTML stays uncached (max-age=0) so
# new deploys go live instantly.
/art/*
  Cache-Control: public, max-age=86400
/favicon.png
  Cache-Control: public, max-age=604800
/og.png
  Cache-Control: public, max-age=604800
