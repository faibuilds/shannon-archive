   "aboutIds": [
    "boolean-algebra"
   ],
   "text": "Boolean algebra became foundational to telephone switching and digital computer circuits after Claude Shannon found it the tool for designing switching circuits in the late 1930s.",
   "sourceNote": "Britannica; Linda Hall Library"
  },
  {
   "id": "c-boolean-algebra-03",
   "type": "claim",
   "status": "verified",
   "aboutIds": [
    "boolean-algebra"
   ],
   "text": "Before Boole, formal logic was an Aristotelian catalog of valid syllogism patterns; Boole's method provided general algebraic algorithms.",
   "sourceNote": "Stanford Encyclopedia of Philosophy"
  },
  {
   "id": "src-lovelace-vcl",
   "type": "source",
   "title": "EC VCL: Lovelace Notes (Jul 2026)",
   "kind": "reference"
  },
  {
